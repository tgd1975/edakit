{
 "graph": {
  "name": "atoomnetmarc-adlsc",
  "version": "1.0",
  "date": "2026-11-03",
  "description": "ADLSC, Atoomnet's Digital Led String Controller (atoomnetmarc/ADLSC, V1.0), as published: a WLED controller – 5 V from a Mean Well IRM-60-5ST through push-in terminals, a bidirectional TVS and an N-MOSFET in the ground return against reversed wires, a 0.5 A polyfuse and a MAX809M supervisor for the logic, an ESP32-DevKitC with ESP32-WROVER-E behind a Schottky, a 74AHCT125 shifting two data lines to 5 V through 100 Ω, two LED power outputs switched by P-MOSFETs from GPIO4 and fused with 3 A glass fuses, TVS diodes and indicator LEDs throughout, 470 µF on +5V. Transcribed for edakit's tests.",
  "purpose": {
   "use": "private",
   "market": "EU",
   "notes": "A hobby controller its author builds and publishes for others to build for themselves (README, CONTRIBUTING.md). The transcription is a test of edakit, not a product."
  },
  "conventions": {
   "pin_reference": "'<designator>.<pin>' with the pin numbers of the LCSC parts' entries – the EasyEDA symbols where there is one (A1: J3 in the EasyEDA order, see its notes; the green KT-0805G LEDs 1 = A, 2 = K)",
   "v": "per net: [min, max] in V over all intended operating states – the IRM-60-5's 5 V ± 2.5 %, the supply wires reversed",
