{
 "comments": {
  "lineComment": "#"
 },
 "brackets": [
  [
   "(",
   ")"
  ],
  [
   "{",
   "}"
  ],
  [
   "[",
   "]"
  ]
 ],
 "autoClosingPairs": [
  {
   "open": "\"",
   "close": "\"",
   "notIn": [
    "string"
   ]
  },
  {
   "open": "(",
   "close": ")"
  },
  {
   "open": "{",
   "close": "}"
  },
  {
   "open": "[",
   "close": "]"
  }
 ],
 "surroundingPairs": [
  [
   "\"",
   "\""
  ],
  [
   "(",
   ")"
  ],
  [
   "{",
   "}"
  ],
  [
   "[",
   "]"
  ]
 ],
 "indentationRules": {
  "increaseIndentPattern": "^\\s*(def|for|variant)\\b.*$",
  "decreaseIndentPattern": "^$"
 }
}
